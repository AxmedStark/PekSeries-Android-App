# Gradle / build output
.gradle/
build/
*/build/
**/build/
buildSrc/build/
build-logic/**/build/
captures/
.externalNativeBuild
.cxx/
.kotlin/
local.properties

# IDE
*.iml
.idea/
.DS_Store
Thumbs.db

# Secrets — never commit.
# secrets.properties.example is the committed template; the real file is not.
secrets.properties
*.jks
*.keystore
firebase-key.json
.secret

# Firebase config carries project identifiers; keep it out of a public repo.
# NOTE: scoped deliberately. A bare "*.json" rule would also swallow Room
# schemas, test fixtures and CI configs.
app/google-services.json
app/src/*/google-services.json

# Firebase Cloud Functions
functions/node_modules/
functions/lib/
functions/.firebase/
.firebase/
firebase-debug.log

# Logs
*.log
