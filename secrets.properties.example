# Copy to secrets.properties (gitignored) and fill in.
#
# Every key here is also read from the environment, and the environment wins.
# CI therefore never writes this file: it exports the variables instead, so no
# credential is ever committed or left on disk in the runner.

# --- API keys ---
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Release signing ---
# Path to the upload keystore, absolute or relative to the repository root.
# Leave empty for local development: release builds then assemble unsigned
# instead of failing.
PEKSERIES_KEYSTORE_FILE=
PEKSERIES_KEYSTORE_PASSWORD=
PEKSERIES_KEY_ALIAS=
PEKSERIES_KEY_PASSWORD=
